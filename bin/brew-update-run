#!/bin/zsh
#
# brew-update-run — open an interactive Terminal window running `brew upgrade`.
#
# Invoked by clicking the brew-update-check notification. A `.command` script is
# written to the state directory and handed to Terminal through LaunchServices,
# so no Apple Events / Automation permission is needed. The window ends in an
# interactive login shell, which leaves it open after the upgrade finishes.
#
# Runs `brew upgrade -y` so the upgrade starts on its own: no interactive
# confirmation prompt, no sudo, no --greedy, and no package names.
#
# Exit codes:
#   0   Terminal was asked to run the upgrade
#   1   could not start Terminal or brew was not found
#
# See AGENTS.md and CONTRACT.md in the repository root.

emulate -L zsh
setopt pipefail

readonly PROG_NAME=${0:t}
readonly NOTIFICATION_GROUP='com.aroglahcim.brew-updater'

export PATH='/usr/bin:/bin:/usr/sbin:/sbin'
umask 077
cd /

readonly HOME_DIR=${HOME:?HOME is not set}
readonly STATE_DIR=${BREW_UPDATER_STATE_DIR:-$HOME_DIR/.local/state/brew-updater}
readonly LOG_DIR=${BREW_UPDATER_LOG_DIR:-$HOME_DIR/Library/Logs/brew-updater}
readonly LOG_FILE=$LOG_DIR/brew-updater.log
readonly TASK_SCRIPT=$STATE_DIR/upgrade.command
readonly NOTIFIED_FILE=$STATE_DIR/notified-count

mkdir -p "$STATE_DIR" "$LOG_DIR" 2>/dev/null

log() {
	local line
	line="$(/bin/date '+%Y-%m-%d %H:%M:%S') [$PROG_NAME] $*"
	print -r -- "$line" >>"$LOG_FILE" 2>/dev/null || true
}

resolve_brew() {
	if [[ -n ${BREW_UPDATER_BREW_BIN:-} ]]; then
		print -r -- "$BREW_UPDATER_BREW_BIN"
		return 0
	fi
	if [[ -x /opt/homebrew/bin/brew ]]; then
		print -r -- /opt/homebrew/bin/brew
		return 0
	fi
	if [[ -x /usr/local/bin/brew ]]; then
		print -r -- /usr/local/bin/brew
		return 0
	fi
	whence -p brew 2>/dev/null
}

# Quote a value as one POSIX shell word, safe for spaces and special characters.
sh_quote() {
	local value=$1 out="'" char
	local -i i
	for (( i = 1; i <= ${#value}; i++ )); do
		char=${value[i]}
		if [[ $char == "'" ]]; then
			out+="'\\''"
		else
			out+=$char
		fi
	done
	print -r -- "$out'"
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
	print -r -- "usage: $PROG_NAME"
	print -r -- ''
	print -r -- 'Opens Terminal and runs `brew upgrade -y`, which does not ask for confirmation.'
	exit 0
fi

brew_bin=$(resolve_brew)
if [[ -z $brew_bin ]]; then
	log 'error: brew not found, cannot upgrade'
	print -r -- "$PROG_NAME: brew not found" >&2
	exit 1
fi

log "opening Terminal to run: $brew_bin upgrade -y"

# Clear this automation's notification so it does not linger after the click.
notifier_bin=${BREW_UPDATER_NOTIFIER_BIN:-}
if [[ -z $notifier_bin ]]; then
	local candidate
	for candidate in /opt/homebrew/bin/terminal-notifier /usr/local/bin/terminal-notifier; do
		if [[ -x $candidate ]]; then
			notifier_bin=$candidate
			break
		fi
	done
fi
[[ -n $notifier_bin ]] && "$notifier_bin" -remove "$NOTIFICATION_GROUP" >/dev/null 2>&1

# Drop the remembered count: with the notification gone, the next scheduled run
# must be free to post it again for the current set of outdated packages.
rm -f "$NOTIFIED_FILE" 2>/dev/null && log 'cleared notified count'

# The task script is fully static apart from the quoted brew path. No package
# name, no notification text, and no brew output ever reaches it.
typeset tmp_script="$TASK_SCRIPT.tmp.$$"
{
	print -r -- '#!/bin/zsh'
	print -r -- '# Generated by brew-update-run; runs one brew upgrade without a prompt.'
	print -r -- "cd $(sh_quote "$HOME_DIR") || exit 1"
	print -r -- "print -r -- 'Homebrew: uruchamiam brew upgrade. Ctrl-C anuluje.'"
	print -r -- "print -r -- ''"
	print -r -- "$(sh_quote "$brew_bin") upgrade -y"
	print -r -- 'typeset -i rc=$?'
	print -r -- "print -r -- ''"
	print -r -- "print -r -- \"Homebrew: brew upgrade zakonczony z kodem \$rc.\""
	print -r -- "print -r -- 'To okno zostaje otwarte, aby mozna bylo sprawdzic wynik.'"
	# Replace this script with a login shell so the Terminal window stays open.
	print -r -- 'exec /bin/zsh -l'
} >"$tmp_script" || {
	log 'error: could not write task script'
	print -r -- "$PROG_NAME: could not write task script" >&2
	exit 1
}
chmod 700 "$tmp_script"
mv -f "$tmp_script" "$TASK_SCRIPT"

# `open -a Terminal <file>` goes through LaunchServices, not Apple Events, so it
# needs no Automation permission. Terminal opens the .command file in a window.
if /usr/bin/open -a Terminal "$TASK_SCRIPT" 2>>"$LOG_FILE"; then
	log 'Terminal opened for brew upgrade'
	print -r -- "$PROG_NAME: Terminal opened"
	exit 0
fi

log 'error: could not open Terminal'
print -r -- "$PROG_NAME: could not open Terminal" >&2
exit 1
